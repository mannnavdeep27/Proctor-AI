# Copy this file to ".env" for local development. On Vercel, add the same names in
# Project Settings -> Environment Variables instead. Never commit your real .env file.

# development (default) or production
APP_ENV=development
# Required in production: any long random string (python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-me

# ---- Database -------------------------------------------------------------
# Local XAMPP defaults:
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=root
DB_PASSWORD=
DB_NAME=proctorai
# Hosted MySQL (TiDB Cloud, Aiven, ...) usually needs SSL:
DB_SSL=false

# ---- First admin account (created automatically on first start) ----------
# In production you MUST set both. In development the defaults are admin / admin123.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ---- Email for OTPs (choose ONE option; leave all empty for DEV MODE) -----
# Dev mode (development only): the OTP is shown on the page and printed in the console.
#
# Option 1 - Brevo (free, works with a verified Gmail sender address)
# BREVO_API_KEY=
# MAIL_FROM_EMAIL=yourname@gmail.com
# MAIL_FROM_NAME=ProctorAI
#
# Option 2 - Resend (needs a verified domain)
# RESEND_API_KEY=
# MAIL_FROM_EMAIL=noreply@yourdomain.com
#
# Option 3 - Gmail SMTP with an App Password
# SMTP_USER=yourname@gmail.com
# SMTP_PASSWORD=your-16-character-app-password
